from scipy import signal
from scipy.signal import medfilt, butter, filtfilt

def pipeline_v2(strain_h1: np.ndarray, strain_l1: np.ndarray, times: np.ndarray) -> tuple[np.ndarray, np.ndarray, np.ndarray]:
    """
    Pipeline version 2 for gravitational wave signal detection.
    This version implements improved adaptive windowing, multi-scale fusion,
    dynamic threshold calibration, cross-detector consistency, and enhanced detrending.
    
    Inputs:
      strain_h1: 1D numpy array of H1 detector strain data.
      strain_l1: 1D numpy array of L1 detector strain data.
      times: 1D numpy array of GPS time stamps corresponding to the strain data.
      
    Returns:
      A tuple of (peak_times, peak_heights, peak_deltat), where:
        peak_times: GPS times of identified candidate events.
        peak_heights: Ranking/significance factors for each candidate.
        peak_deltat: Estimated timing uncertainty for each candidate.
    """
    dt = times[1] - times[0]
    fs = 1.0 / dt
    
    # -------------------------------------
    # 1. Enhanced Adaptive Data Conditioning
    # -------------------------------------
    def adaptive_data_conditioning(strain: np.ndarray) -> np.ndarray:
        # Improved robust detrending: median filtering with kernel based on fixed time window (~0.2s)
        ker_width = int(0.2 * fs)
        if ker_width % 2 == 0:
            ker_width += 1
        trend = medfilt(strain, kernel_size=min(ker_width, len(strain) // 2 | 1))
        detrended = strain - trend
        
        # Remove residual linear trend (zero-phase linear detrending)
        t_idx = np.arange(len(detrended))
        p = np.polyfit(t_idx, detrended, 1)
        lin_trend = np.polyval(p, t_idx)
        detrended -= lin_trend
        
        # Adaptive whitening via two-stage PSD estimation:
        data_zero = detrended - np.mean(detrended)
        nperseg1 = int(min(4096, len(data_zero) // 8))
        nperseg1 = max(nperseg1, 256)
        nperseg2 = max(256, nperseg1 // 2)
        
        freqs1, psd1 = signal.welch(data_zero, fs=fs, nperseg=nperseg1, window='hann', noverlap=nperseg1//2)
        freqs2, psd2 = signal.welch(data_zero, fs=fs, nperseg=nperseg2, window='hann', noverlap=nperseg2//2)
        psd2_interp = np.interp(freqs1, freqs2, psd2)
        combined_psd = np.sqrt(psd1 * psd2_interp)
        # Smooth PSD estimates with two-stage moving average
        smooth_psd = np.convolve(combined_psd, np.ones(32)/32, mode='same')
        smooth_psd = np.convolve(smooth_psd, np.ones(16)/16, mode='same')
        smooth_psd = np.maximum(smooth_psd, np.finfo(float).tiny)
        
        # Whitening in frequency domain
        data_fft = np.fft.rfft(data_zero)
        freqs_fft = np.fft.rfftfreq(len(data_zero), d=dt)
        psd_interp = np.interp(freqs_fft, freqs1, smooth_psd)
        white_fft = data_fft / np.sqrt(psd_interp)
        white_data = np.fft.irfft(white_fft, n=len(data_zero))
        return white_data

    whitened_h1 = adaptive_data_conditioning(strain_h1)
    whitened_l1 = adaptive_data_conditioning(strain_l1)

    # -------------------------------------
    # 2. Multi-scale Time-Frequency Fusion with Cross-Detector Consistency
    # -------------------------------------
    def compute_metric_series(h1_data: np.ndarray, l1_data: np.ndarray) -> tuple[np.ndarray, np.ndarray]:
        fs_local = fs
        
        # Use two STFT scales, and also compute individual spectrograms for cross-check:
        # Scale 1: Higher time resolution
        nperseg1, noverlap1 = 128, 96
        f1, t1, Sxx_h1_sc1 = signal.spectrogram(h1_data, fs=fs_local, nperseg=nperseg1, noverlap=noverlap1, 
                                                 window='hann', mode='magnitude', detrend=False)
        _, _, Sxx_l1_sc1 = signal.spectrogram(l1_data, fs=fs_local, nperseg=nperseg1, noverlap=noverlap1, 
                                              window='hann', mode='magnitude', detrend=False)
        
        # Scale 2: Better frequency resolution
        nperseg2, noverlap2 = 512, 384
        f2, t2, Sxx_h1_sc2 = signal.spectrogram(h1_data, fs=fs_local, nperseg=nperseg2, noverlap=noverlap2, 
                                                 window='hann', mode='magnitude', detrend=False)
        _, _, Sxx_l1_sc2 = signal.spectrogram(l1_data, fs=fs_local, nperseg=nperseg2, noverlap=noverlap2, 
                                              window='hann', mode='magnitude', detrend=False)
        
        # Coherent fusion: emphasize common features using geometric mean per scale
        Sxx_coh_sc1 = np.sqrt(Sxx_h1_sc1 * Sxx_l1_sc1)
        Sxx_coh_sc2 = np.sqrt(Sxx_h1_sc2 * Sxx_l1_sc2)
        
        # Collapse frequency axis (full band average) for each scale
        metric_sc1 = np.mean(Sxx_coh_sc1, axis=0)
        metric_sc2 = np.mean(Sxx_coh_sc2, axis=0)
        # Interpolate scale 2 metric to scale 1 timebase and fuse using weighted geometric mean
        metric_sc2_interp = np.interp(t1, t2, metric_sc2)
        fused_metric = np.sqrt(metric_sc1 * metric_sc2_interp)
        
        # Cross-detector consistency check via independent correlation estimation:
        # Compute normalized cross-correlation of individual spectrogram metrics
        norm_h1 = (np.mean(Sxx_h1_sc1, axis=0) - np.mean(Sxx_h1_sc1, axis=0))  # zero mean already after whitening
        norm_l1 = (np.mean(Sxx_l1_sc1, axis=0) - np.mean(Sxx_l1_sc1, axis=0))
        # (Here we simply compute correlation coefficient over sliding windows)
        # For simplicity, assume high coherence if fused_metric exceeds median by threshold.
        # In practice, more detailed cross-correlation might be used.
        
        # Map STFT bin times to GPS times (centered on mid segment)
        segment_mid = times[0] + (times[-1] - times[0]) / 2.0
        metric_times = segment_mid + (t1 - t1[len(t1)//2])
        return fused_metric, metric_times

    tf_metric, metric_times = compute_metric_series(whitened_h1, whitened_l1)
    
    # -------------------------------------
    # 3. Dynamic Statistics, Candidate Selection, and Physical Vetoes
    # -------------------------------------
    def calculate_statistics(tf_metric: np.ndarray, metric_times: np.ndarray) -> tuple[np.ndarray, np.ndarray, np.ndarray]:
        # Robust statistics using median and MAD
        med_val = np.median(tf_metric)
        mad = np.median(np.abs(tf_metric - med_val))
        if mad <= 0:
            mad = np.std(tf_metric) if np.std(tf_metric) > 0 else 1.0
        
        # Dynamic thresholding calibrated with MAD; increase threshold during high noise
        threshold = med_val + 3.5 * mad
        threshold = max(threshold, med_val * 1.2)
        
        # Find peaks from fused metric
        peaks, props = signal.find_peaks(tf_metric, height=threshold, distance=2, prominence=mad)
        candidate_times = metric_times[peaks]
        candidate_heights = tf_metric[peaks]
        
        # Enforce physical timing consistency:
        # For gravitational waves, the time delay between detectors should be ~few tens of ms.
        # Here, we set a conservative uncertainty window based on segment duration (e.g., 0.5%).
        uncertainty = (metric_times[-1] - metric_times[0]) * 0.005
        
        # For candidate vetoes, one could incorporate additional detectors or cross-correlation of raw channels.
        # In this prototype, we simply assign the same timing uncertainty to all triggers.
        candidate_deltat = np.full_like(candidate_times, uncertainty)
        return candidate_times, candidate_heights, candidate_deltat

    peak_times, peak_heights, peak_deltat = calculate_statistics(tf_metric, metric_times)
    return peak_times, peak_heights, peak_deltat
