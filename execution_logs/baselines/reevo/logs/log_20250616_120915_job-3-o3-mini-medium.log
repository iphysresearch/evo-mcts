    """
    Pipeline_v2 processes dual-channel gravitational wave data from the H1 and L1 detectors,
    applying advanced conditioning and coherent multi-detector analysis techniques to identify
    candidate gravitational wave signals.
    
    It returns a tuple of numpy arrays:
      - peak_times: GPS times at which triggers are identified.
      - peak_heights: Significance (ranking statistic) measure for each trigger.
      - peak_deltat: Uncertainty (in seconds) associated with each trigger time.
    """
    
    def data_conditioning_v2(strain_h1: np.ndarray, strain_l1: np.ndarray, times: np.ndarray) -> tuple[np.ndarray, np.ndarray, np.ndarray]:
        """
        Perform data conditioning on both channels:
          1. Remove the DC offset.
          2. Apply a Butterworth bandpass filter (20 Hz - 500 Hz) to remove out-of-band noise.
          3. Optionally, apply an additional whitening step after filtering using an FFT-based method.
        """
        dt = times[1] - times[0]
        fs = 1.0 / dt
        
        # Remove mean (detrending)
        strain_h1 = strain_h1 - np.mean(strain_h1)
        strain_l1 = strain_l1 - np.mean(strain_l1)
        
        # Design a Butterworth bandpass filter
        lowcut = 20.0   # Hz
        highcut = 500.0 # Hz
        order = 4
        nyquist = 0.5 * fs
        low = lowcut / nyquist
        high = highcut / nyquist
        b, a = signal.butter(order, [low, high], btype='band')
        
        # Apply zero-phase filtering
        filtered_h1 = signal.filtfilt(b, a, strain_h1)
        filtered_l1 = signal.filtfilt(b, a, strain_l1)
        
        # Whitening via FFT division by smooth amplitude spectral density.
        def whiten(data: np.ndarray) -> np.ndarray:
            # Compute PSD using Welch's method.
            win_length = 4096
            freqs, psd = signal.welch(data, fs=fs, window='hann', nperseg=win_length, noverlap=win_length//2)
            # Smooth the PSD with a moving average filter.
            smooth_psd = np.convolve(psd, np.ones(32)/32, mode='same')
            smooth_psd = np.maximum(smooth_psd, np.finfo(float).tiny)
            # FFT of time series.
            data_fft = np.fft.rfft(data)
            freqs_fft = np.fft.rfftfreq(len(data), d=dt)
            # Interpolate PSD to match FFT frequencies.
            interp_psd = np.interp(freqs_fft, freqs, smooth_psd)
            # Whiten by dividing FFT by sqrt(psd)
            white_fft = data_fft / np.sqrt(interp_psd)
            white_data = np.fft.irfft(white_fft, n=len(data))
            return white_data

        whitened_h1 = whiten(filtered_h1)
        whitened_l1 = whiten(filtered_l1)
        
        return whitened_h1, whitened_l1, times

    def compute_coherence_metric(h1_data: np.ndarray, l1_data: np.ndarray, time_series: np.ndarray) -> tuple[np.ndarray, np.ndarray]:
        """
        Compute a coherent time-frequency metric based on the STFTs of the H1 and L1 channels.
        
        For each time window obtained from the spectrogram, we calculate a cosine similarity
        between the spectral amplitude vectors, which acts as a coherent measure. This measure
        is further modulated by the mean spectral energy in the window.
        """
        dt = time_series[1] - time_series[0]
        fs = 1.0 / dt
        
        # Compute spectrograms
        nperseg = 256
        noverlap = 128
        f_h1, t_spec, Sxx_h1 = signal.spectrogram(h1_data, fs=fs, nperseg=nperseg, noverlap=noverlap, mode='magnitude', detrend=False)
        f_l1, t_spec, Sxx_l1 = signal.spectrogram(l1_data, fs=fs, nperseg=nperseg, noverlap=noverlap, mode='magnitude', detrend=False)
        
        # Number of time bins in the spectrogram
        num_bins = Sxx_h1.shape[1]
        tf_metric = np.zeros(num_bins)
        
        for i in range(num_bins):
            # Extract spectral amplitude vectors for each detector at time bin i.
            vec_h1 = Sxx_h1[:, i]
            vec_l1 = Sxx_l1[:, i]
            
            # Compute cosine similarity (dot product normalized by norms)
            norm_h1 = np.linalg.norm(vec_h1)
            norm_l1 = np.linalg.norm(vec_l1)
            if norm_h1 > 0 and norm_l1 > 0:
                cosine_sim = np.dot(vec_h1, vec_l1) / (norm_h1 * norm_l1)
            else:
                cosine_sim = 0.0
            
            # Compute average spectral energy factor as geometric mean of norms.
            energy_factor = np.sqrt(norm_h1 * norm_l1)
            
            # Combine similarity and energy factor to form a coherent metric.
            tf_metric[i] = cosine_sim * energy_factor
        
        # Adjust times: t_spec is relative to the start of the segment; tag with GPS times.
        gps_start = time_series[0]
        metric_times = gps_start + t_spec
        
        return tf_metric, metric_times

    def calculate_statistics(tf_metric: np.ndarray, metric_times: np.ndarray) -> tuple[np.ndarray, np.ndarray, np.ndarray]:
        """
        Identify candidate gravitational wave signals by finding peaks in the coherent metric.
        Use a dynamic threshold based on the median background and require a minimum prominence.
        """
        # Estimate the background level from the median of the metric.
        background_level = np.median(tf_metric)
        
        # Define thresholds for peak detection.
        # A peak should be above the background level by at least 1.5x and have sufficient prominence.
        min_height = background_level * 1.5
        min_prominence = background_level * 0.5
        
        # Detect peaks in the tf_metric time series.
        peaks, properties = signal.find_peaks(tf_metric, height=min_height, prominence=min_prominence, distance=2)
        
        peak_times = metric_times[peaks]
        peak_heights = tf_metric[peaks]
        # Assign a fixed uncertainty for each peak (could be refined further using, e.g., Cramer-Rao bounds).
        peak_deltat = np.full(len(peak_times), 10.0)
        
        return peak_times, peak_heights, peak_deltat

    # Run data conditioning
    conditioned_h1, conditioned_l1, data_times = data_conditioning_v2(strain_h1, strain_l1, times)
    
    # Perform coherent time-frequency analysis based on STFT spectrograms.
    tf_metric, metric_times = compute_coherence_metric(conditioned_h1, conditioned_l1, data_times)
    
    # Identify candidate triggers from the coherence metric.
    peak_times, peak_heights, peak_deltat = calculate_statistics(tf_metric, metric_times)
    
    return peak_times, peak_heights, peak_deltat

