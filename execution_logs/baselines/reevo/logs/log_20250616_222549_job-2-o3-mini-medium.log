    # Data Conditioning: detrend, bandpass-filter, and whitening
    def data_conditioning_v2(strain: np.ndarray, fs: float) -> np.ndarray:
        # Remove linear trend
        detrended = signal.detrend(strain)

        # Bandpass filter: using a Butterworth filter (simulate typical GW frequency band: 30-300 Hz)
        f_low = 30.0
        f_high = 300.0
        nyq = 0.5 * fs
        low = f_low / nyq
        high = f_high / nyq
        b, a = butter(4, [low, high], btype='band')
        filtered = filtfilt(b, a, detrended)

        # Whitening: apply FFT whitening using an estimate of the PSD
        nperseg = 4096
        freqs, psd = signal.welch(filtered, fs=fs, nperseg=nperseg, window='hann', noverlap=nperseg//2)
        # Smooth PSD to avoid division by very small numbers
        smooth_psd = np.convolve(psd, np.ones(32)/32, mode='same')
        # Avoid division by zero issues
        smooth_psd = np.maximum(smooth_psd, np.finfo(float).tiny)
        # FFT of the signal
        sig_fft = np.fft.rfft(filtered)
        freqs_fft = np.fft.rfftfreq(len(filtered), d=1/fs)
        # Interpolate the PSD to the FFT frequencies and whiten
        psd_interp = np.interp(freqs_fft, freqs, smooth_psd)
        white_fft = sig_fft / np.sqrt(psd_interp)
        white = np.fft.irfft(white_fft, n=len(filtered))
        return white

    # Time-Frequency Coherent Analysis using STFT and cross-spectrum
    def compute_metric_series_v2(h1_data: np.ndarray, l1_data: np.ndarray, fs: float, times: np.ndarray) -> tuple[np.ndarray, np.ndarray]:
        # STFT parameters 
        nperseg = 256
        noverlap = nperseg // 2
        
        # Compute STFT for each channel
        f1, t1, Zxx_h1 = stft(h1_data, fs=fs, nperseg=nperseg, noverlap=noverlap, window='hann', detrend=False)
        f2, t2, Zxx_l1 = stft(l1_data, fs=fs, nperseg=nperseg, noverlap=noverlap, window='hann', detrend=False)
        
        # Ensure time bins match; use t1 for both (they should, if signals are same length)
        # Coherent cross-spectrum: product of H1 and complex conjugate of L1 and average over frequency bins
        cross_spec = np.abs(Zxx_h1 * np.conjugate(Zxx_l1))
        tf_metric = np.mean(cross_spec, axis=0)
        
        # Map the STFT time bins to GPS times, assuming times is the original time series
        t0 = times[0]
        dt = times[1] - times[0]
        total_time = times[-1] - times[0]
        # t1 (from STFT) are relative times from the start of the data segment
        metric_times = t0 + t1
        
        return tf_metric, metric_times

