def pipeline_v1(strain_h1: np.ndarray, strain_l1: np.ndarray, times: np.ndarray) -> tuple[np.ndarray, np.ndarray, np.ndarray]:

    # Data Conditioning: detrend, bandpass filter, and whitening using FFT-based method
    def butter_bandpass_filter(data, lowcut, highcut, fs, order=4):
        nyq = 0.5 * fs
        low = lowcut / nyq
        high = highcut / nyq
        b, a = butter(order, [low, high], btype='band')
        return filtfilt(b, a, data)

    def whiten_signal(data, fs, window_length=2048):
        data = data - np.mean(data)
        # estimate psd with Welch method and use Hann window smoothing
        freqs, psd = signal.welch(data, fs=fs, nperseg=window_length, window='hann', noverlap=window_length//2)
        # Smoothing using a moving average filter on the psd estimate
        smooth_psd = np.convolve(psd, np.ones(32) / 32, mode='same')
        smooth_psd = np.maximum(smooth_psd, np.finfo(float).tiny)
        # FFT whitening using interpolation to map PSD to FFT frequencies
        data_fft = np.fft.rfft(data)
        freqs_fft = np.fft.rfftfreq(len(data), d=1/fs)
        white_fft = data_fft / np.sqrt(np.interp(freqs_fft, freqs, smooth_psd))
        return np.fft.irfft(white_fft, n=len(data))
    
    def data_conditioning(sig_h1, sig_l1, times):
        dt = times[1] - times[0]
        fs = 1.0 / dt
        # Remove trends using detrending
        sig_h1 = signal.detrend(sig_h1)
        sig_l1 = signal.detrend(sig_l1)
        # Apply bandpass filtering in the typical gravitational-wave band (20Hz to 500Hz)
        lowcut = 20.0
        highcut = 500.0
        sig_h1 = butter_bandpass_filter(sig_h1, lowcut, highcut, fs, order=4)
        sig_l1 = butter_bandpass_filter(sig_l1, lowcut, highcut, fs, order=4)
        # Whiten signals using frequency-domain whitening
        white_h1 = whiten_signal(sig_h1, fs, window_length=2048)
        white_l1 = whiten_signal(sig_l1, fs, window_length=2048)
        return white_h1, white_l1, times, fs

    # Coherent network analysis using dual-channel time-frequency spectrograms
    def compute_coherent_metric(white_h1, white_l1, times, fs):
        # Use STFT spectrogram with a longer window for improved frequency resolution
        nperseg = 512
        noverlap = 256
        f_h1, t_spec, Sxx_h1 = signal.spectrogram(white_h1, fs=fs, nperseg=nperseg, 
                                                   noverlap=noverlap, mode='magnitude', window='hann')
        f_l1, t_spec, Sxx_l1 = signal.spectrogram(white_l1, fs=fs, nperseg=nperseg, 
                                                   noverlap=noverlap, mode='magnitude', window='hann')
        # Perform a coherent network combination using the geometric mean of the magnitudes
        coherent_tf = np.sqrt(Sxx_h1 * Sxx_l1)
        # Collapse the frequency axis to get a time series metric (e.g., summing power over frequencies)
        metric = np.sum(coherent_tf, axis=0)
        # Map spectrogram time stamps to approximate GPS times
        # Assume the segment is centered at the midpoint of the times array
        gps_mid_time = times[0] + (times[-1] - times[0]) / 2.0
        # Adjust the spectrogram times such that t_spec=0 corresponds to mid time
        metric_times = gps_mid_time + (t_spec - (t_spec[-1] - t_spec[0]) / 2.0)
        return metric, metric_times

    # Signal-based vetoes and trigger statistics
    def calculate_triggers(metric, time_metric):
        # Determine a dynamic threshold: use median plus a factor of the robust std dev (MAD approximation)
        med = np.median(metric)
        mad = np.median(np.abs(metric - med))
        threshold = med + 4 * mad
        # Find peaks in the time series metric that exceed the threshold
        peaks, properties = signal.find_peaks(metric, height=threshold, distance=5, prominence=2*mad)
        # For timing uncertainty, assign a fixed window based on STFT window duration (~nperseg/fs seconds)
        dt_uncertainty = 512 / (2 * (time_metric[-1] - time_metric[0]) / len(time_metric))
        peak_times = time_metric[peaks]
        peak_heights = metric[peaks]
        peak_deltat = np.full(len(peak_times), dt_uncertainty)
        return peak_times, peak_heights, peak_deltat

    # Pipeline execution
    white_h1, white_l1, conditioned_times, fs = data_conditioning(strain_h1, strain_l1, times)
    tf_metric, metric_times = compute_coherent_metric(white_h1, white_l1, conditioned_times, fs)
    peak_times, peak_heights, peak_deltat = calculate_triggers(tf_metric, metric_times)
    return peak_times, peak_heights, peak_deltat

