    def data_conditioning_v2(strain: np.ndarray, fs: float) -> np.ndarray:
        # Apply a 4th order Butterworth bandpass filter (e.g., 30-300 Hz) to remove low-frequency and high-frequency noise.
        lowcut, highcut = 30.0, 300.0  # Hz; typical range for gravitational wave searches in ground detectors
        order = 4
        nyq = 0.5 * fs
        low = lowcut / nyq
        high = highcut / nyq
