    # Use the Short-Time Fourier Transform (STFT) with a Hann window.
    f_h1, t_stft, Zxx_h1 = signal.stft(conditioned_h1, fs=fs, window='hann',
                                       nperseg=256, noverlap=200, detrend=False)
    f_l1, t_stft_l, Zxx_l1 = signal.stft(conditioned_l1, fs=fs, window='hann',
                                         nperseg=256, noverlap=200, detrend=False)
    # Ensure time bins align between detectors.
    if not np.allclose(t_stft, t_stft_l):
        raise ValueError("STFT time bins do not match between detectors.")

    # Compute power spectrograms
    power_h1 = np.abs(Zxx_h1)**2
    power_l1 = np.abs(Zxx_l1)**2
    avg_power_h1 = np.mean(power_h1, axis=0)
    avg_power_l1 = np.mean(power_l1, axis=0)

    # ------------------------------------
    # Stage 3: Coherent Network Analysis
    # ------------------------------------
    # Evaluate the cross-spectrum coherence between the detectors.
    cross_spectrum = np.real(Zxx_h1 * np.conjugate(Zxx_l1))
    avg_cross = np.mean(cross_spectrum, axis=0)
    # The coherence factor is normalized by the geometric mean of the average powers.
    coherence = avg_cross / (np.sqrt(avg_power_h1 * avg_power_l1) + 1e-8)

    # Combine the average power from H1 and L1 with a boost for coherent features.
    # (The coherence term typically lies in [-1, 1]; adding 1 ensures the multiplier is nonnegative.)
    combined_metric = ((avg_power_h1 + avg_power_l1) / 2) * (coherence + 1.0)

    # ------------------------------------
    # Stage 4: Trigger Identification & Statistics
