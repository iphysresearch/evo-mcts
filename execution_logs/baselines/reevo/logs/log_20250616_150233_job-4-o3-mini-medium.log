    """
    A more creative pipeline for gravitational wave signal detection that leverages:
      - Advanced bandpass filtering and whitening
      - Coherent network analysis via STFT and waveform consistency check
      - Signal-based vetoes using peak width estimation
    The input parameters are raw strain data from the H1 and L1 detectors and its corresponding times.
    Returns three numpy arrays: 
      peak_times: GPS times of detected candidate events,
      peak_heights: Ranking statistic for each candidate event,
      peak_deltat: Timing uncertainty associated with each event.
    """
    
    def data_conditioning_v2(strain_h1: np.ndarray, strain_l1: np.ndarray, times: np.ndarray) -> tuple[np.ndarray, np.ndarray, np.ndarray]:
        dt = times[1] - times[0]
        fs = 1.0 / dt
        
        # Apply a Butterworth bandpass filter [20, 500] Hz common for gravitational waves.
        lowcut, highcut = 20.0, 500.0
        order = 4
        b, a = signal.butter(order, [lowcut / (fs / 2), highcut / (fs / 2)], btype='bandpass')
        filt_h1 = signal.filtfilt(b, a, strain_h1)
        filt_l1 = signal.filtfilt(b, a, strain_l1)
        
        # Whiten the data using FFT-based method with a median smoothed PSD.
        def whiten(data: np.ndarray) -> np.ndarray:
            data = data - np.mean(data)
            # Estimate PSD using Welch's method.
            segment = 4096
            freqs, psd = signal.welch(data, fs=fs, nperseg=segment, window='hann', noverlap=segment//2)
            psd_med = np.convolve(psd, np.ones(32) / 32, mode='same')
            psd_med = np.maximum(psd_med, np.finfo(float).tiny)
            # Fourier transform and division by sqrt(psd).
            data_fft = np.fft.rfft(data)
            freqs_fft = np.fft.rfftfreq(len(data), d=dt)
            white_data_fft = data_fft / np.sqrt(np.interp(freqs_fft, freqs, psd_med))
            white_data = np.fft.irfft(white_data_fft, n=len(data))
            return white_data
        
        white_h1 = whiten(filt_h1)
        white_l1 = whiten(filt_l1)
        
        # Optional non-linear noise suppression using a median filter.
        white_h1 = signal.medfilt(white_h1, kernel_size=5)
        white_l1 = signal.medfilt(white_l1, kernel_size=5)
        
        return white_h1, white_l1, times

    def compute_metric_series_v2(whitened_h1: np.ndarray, whitened_l1: np.ndarray, times: np.ndarray) -> tuple[np.ndarray, np.ndarray]:
        dt = times[1] - times[0]
        fs = 1.0 / dt
        
        # Compute Short-Time Fourier Transforms for both detectors.
        nperseg = 256
        noverlap = 192  # more overlap for smoother time resolution
        f, t_stft, Zxx_h1 = signal.stft(whitened_h1, fs=fs, window='hann', nperseg=nperseg, noverlap=noverlap)
        _, _, Zxx_l1 = signal.stft(whitened_l1, fs=fs, window='hann', nperseg=nperseg, noverlap=noverlap)
        
        # Coherent network analysis: compute the cross-power spectral density by multiplying one transform with the complex conjugate of the other.
        # Sum across frequency bins to obtain a time-series metric.
        cross_coherence = np.sum(np.abs(Zxx_h1 * np.conj(Zxx_l1)), axis=0)
        
        # Enhance detection using a simple wavelet-like consistency check.
        # For each time slice, take the median power from single-detector STFT and combine.
        power_h1 = np.sum(np.abs(Zxx_h1)**2, axis=0)
        power_l1 = np.sum(np.abs(Zxx_l1)**2, axis=0)
        combined_power = np.sqrt((power_h1 + power_l1) / 2)
        
        # Combine the network coherence metric with the combined power; normalize to form a ranking statistic.
        tf_metric = cross_coherence * (combined_power / (np.median(combined_power) + 1e-12))
        
        # Construct metric times relative to the segment's start time.
        metric_times = times[0] + t_stft
        
        return tf_metric, metric_times

    def calculate_statistics_v2(tf_metric: np.ndarray, metric_times: np.ndarray) -> tuple[np.ndarray, np.ndarray, np.ndarray]:
        # Determine a background level estimate.
        background = np.median(tf_metric)
        
        # Use prominence based thresholding to find peaks in the metric (signal candidates).
        peaks, properties = signal.find_peaks(tf_metric, height=background * 1.5, distance=4, prominence=background * 0.4)
        
        # Calculate widths of the peaks as a proxy for timing uncertainty
        widths, width_heights, left_ips, right_ips = signal.peak_widths(tf_metric, peaks, rel_height=0.5)
        peak_deltat = widths * (metric_times[1] - metric_times[0])
        
        peak_times = metric_times[peaks]
        peak_heights = tf_metric[peaks]
        
        return peak_times, peak_heights, peak_deltat

    # Step 1: Conditioning the raw data from both detectors.
    white_h1, white_l1, conditioned_times = data_conditioning_v2(strain_h1, strain_l1, times)
    # Step 2: Performing time-frequency domain transformation and coherent network analysis.
    tf_metric, metric_times = compute_metric_series_v2(white_h1, white_l1, conditioned_times)
    # Step 3: Extracting candidate events using peak detection and computing timing uncertainties.
    peak_times, peak_heights, peak_deltat = calculate_statistics_v2(tf_metric, metric_times)
    
    return peak_times, peak_heights, peak_deltat

