def pipeline_v1(strain_h1: np.ndarray, strain_l1: np.ndarray, times: np.ndarray) -> tuple[np.ndarray, np.ndarray, np.ndarray]:

    """
    Improved pipeline for gravitational wave signal detection with adaptive filtering,
    dynamic thresholding for peak detection, and robust multi-detector metric fusion.

    Parameters:
      strain_h1: numpy array of raw detector strain data from H1.
      strain_l1: numpy array of raw detector strain data from L1.
      times: numpy array with time stamps corresponding to the strain samples.
      
    Returns:
      peak_times: numpy array of estimated GPS trigger times.
      peak_heights: numpy array with trigger significance values.
      peak_deltat: numpy array representing the timing uncertainty window for each trigger.
    """
    dt = times[1] - times[0]
    fs = 1.0 / dt

    # Adaptive data conditioning: bandpass filtering and whitening.
    def adaptive_filter_and_whiten(strain: np.ndarray) -> np.ndarray:
        # Remove mean and detrend
        strain = strain - np.mean(strain)
        
        # Adaptive design of Butterworth bandpass filter:
        # Using predetermined band for gravitational wave detection but allow a slight adaptation
        # based on the signal's interquartile range.
        iqr = np.subtract(*np.percentile(strain, [75, 25]))
        noise_scale = np.median(np.abs(strain)) if np.median(np.abs(strain)) > 0 else 1.0
        adapt_factor = np.clip(iqr / (noise_scale + 1e-6), 0.8, 1.2)
        lowcut = 20.0 * adapt_factor
        highcut = 500.0 / adapt_factor

        nyq = 0.5 * fs
        low = lowcut / nyq
        high = highcut / nyq
        b, a = signal.butter(4, [low, high], btype='band')
        filtered = signal.filtfilt(b, a, strain)
        
        # Whitening: using Welch's method and frequency domain whitening.
        window_length = 2048 if len(filtered) >= 2048 else len(filtered)//2
        freqs, psd = signal.welch(filtered, fs=fs, nperseg=window_length, window='hann', noverlap=window_length//2)
        # Smooth the PSD to reduce sharp features.
        smooth_psd = np.convolve(psd, np.ones(32)/32, mode='same')
        smooth_psd = np.maximum(smooth_psd, np.finfo(float).tiny)
        
        # FFT whitening
        fft_data = np.fft.rfft(filtered)
        freq_vals = np.fft.rfftfreq(len(filtered), d=dt)
        interp_psd = np.interp(freq_vals, freqs, smooth_psd)
        white_fft = fft_data / np.sqrt(interp_psd)
        whitened = np.fft.irfft(white_fft, n=len(filtered))
        
        return whitened

    # Apply adaptive filtering and whitening to both detectors.
    whitened_h1 = adaptive_filter_and_whiten(strain_h1)
    whitened_l1 = adaptive_filter_and_whiten(strain_l1)

    # Compute time-frequency representations using STFT with adaptive windows.
    nperseg = 256  # can be adapted based on segment duration, but here kept fixed.
    noverlap = nperseg // 2

    f_h1, t_h1, Zxx_h1 = signal.stft(whitened_h1, fs=fs, window='hann',
                                     nperseg=nperseg, noverlap=noverlap, detrend=False)
    f_l1, t_l1, Zxx_l1 = signal.stft(whitened_l1, fs=fs, window='hann',
                                     nperseg=nperseg, noverlap=noverlap, detrend=False)

    # Improved multi-detector metric fusion:
    # Instead of a simple average of complex spectrograms, we perform a weighted fusion based on local SNR.
    # Compute power spectral densities in each STFT frame.
    power_h1 = np.abs(Zxx_h1) ** 2
    power_l1 = np.abs(Zxx_l1) ** 2
    # Avoid zeros and compute local weights using the median power in each frequency bin.
    weight_h1 = np.median(power_h1, axis=1, keepdims=True)
    weight_l1 = np.median(power_l1, axis=1, keepdims=True)
    total_weight = weight_h1 + weight_l1 + 1e-6  # small offset avoids division by zero

    # Weighted average of spectrogram power across detectors.
    fused_power = (power_h1 * weight_h1 + power_l1 * weight_l1) / total_weight
    # Collapse frequency axis to obtain a time series metric.
    tf_metric = np.median(fused_power, axis=0)

    # Map STFT time stamps to GPS times:
    # Using the start time of the segment.
    metric_times = times[0] + t_h1

    # Dynamic thresholding for peak detection:
    # Use a robust estimate of the background noise.
    med_metric = np.median(tf_metric)
    # Estimate the robust standard deviation from the median absolute deviation.
    mad_metric = np.median(np.abs(tf_metric - med_metric))
    robust_std = 1.4826 * mad_metric
    # Set threshold adaptively: median + k * robust_std.
    k_factor = 3.0
    dynamic_threshold = med_metric + k_factor * robust_std

    # Use prominence relative to the estimated dynamic threshold.
    peaks, properties = signal.find_peaks(tf_metric, height=dynamic_threshold,
                                          prominence=robust_std * 0.8, distance=2)

    # Extract peak trigger parameters:
    peak_times = metric_times[peaks]
    peak_heights = tf_metric[peaks]
    # Estimate timing uncertainty inversely proportional to SNR:
    # For higher peaks, assume smaller timing uncertainty.
    # Cap the uncertainty between 2.0s and 15.0s.
    estimated_sigma = 1 / (peak_heights / (np.max(tf_metric) + 1e-6) + 1e-3) * 10.0
    peak_deltat = np.clip(estimated_sigma, 2.0, 15.0)

    return peak_times, peak_heights, peak_deltat

