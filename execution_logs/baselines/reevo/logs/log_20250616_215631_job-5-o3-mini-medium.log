    """
    Pipeline v2 for gravitational wave signal detection.
    
    This pipeline performs advanced data conditioning (using a Butterworth bandpass filter
    and frequency-domain whitening), then conducts a time-frequency analysis using the STFT,
    followed by a coherent network analysis that combines the two detector outputs.
    Finally, the pipeline performs multi-detector consistency checks and signal-based vetoes
    via peak detection over the combined metric.
    
    Parameters:
      strain_h1: numpy array of raw detector strain data from H1.
      strain_l1: numpy array of raw detector strain data from L1.
      times: numpy array with time stamps corresponding to the strain samples.
      
    Returns:
      peak_times: numpy array of estimated GPS trigger times.
      peak_heights: numpy array of trigger significance values.
      peak_deltat: numpy array representing the timing uncertainty window for each trigger.
    """
    
    dt = times[1] - times[0]
    fs = 1.0 / dt

    # Data Conditioning: Butterworth Bandpass Filtering and Whitening.
    def filter_and_whiten(strain: np.ndarray) -> np.ndarray:
        # Remove mean
        strain = strain - np.mean(strain)
        
        # Design a Butterworth bandpass filter
        # For instance, consider signals between 20 Hz and 500 Hz (typical gravitational wave band)
        lowcut = 20.0
        highcut = 500.0
        nyq = 0.5 * fs
        low = lowcut / nyq
        high = highcut / nyq
        b, a = signal.butter(4, [low, high], btype='band')
        
        # Apply zero-phase filtering
        filtered_strain = signal.filtfilt(b, a, strain)
        
        # Whitening: estimate the PSD via Welch's method and whiten in the frequency domain.
        window_length = 2048
        freqs, psd = signal.welch(filtered_strain, fs=fs, nperseg=window_length, window='hann', noverlap=window_length//2)
        # Smooth the PSD to avoid sharp spectral features
        smooth_psd = np.convolve(psd, np.ones(32)/32, mode='same')
        smooth_psd = np.maximum(smooth_psd, np.finfo(float).tiny)
        
        # Perform Fourier Transform and weight by inverse sqrt(PSD)
        strain_zero_mean = filtered_strain
        fft_strain = np.fft.rfft(strain_zero_mean)
        freq_vals = np.fft.rfftfreq(len(strain_zero_mean), d=dt)
        interp_psd = np.interp(freq_vals, freqs, smooth_psd)
        white_fft = fft_strain / np.sqrt(interp_psd)
        whitened = np.fft.irfft(white_fft, n=len(strain_zero_mean))
        
        return whitened

    whitened_h1 = filter_and_whiten(strain_h1)
    whitened_l1 = filter_and_whiten(strain_l1)
    
    # Time-Frequency Analysis using Short-Time Fourier Transform (STFT)
    # Use different window function and overlap settings.
    nperseg = 256
    noverlap = 128
    f, t_stft, Zxx_h1 = signal.stft(whitened_h1, fs=fs, window='hann',
                                    nperseg=nperseg, noverlap=noverlap, detrend=False)
    _, t_stft, Zxx_l1 = signal.stft(whitened_l1, fs=fs, window='hann',
                                    nperseg=nperseg, noverlap=noverlap, detrend=False)
    
    # Coherent Network Analysis: combine spectrograms from H1 and L1.
    # For robust detection, we sum the complex spectrograms and average,
    # then compute the time series metric as the average power over the frequency band.
    Zxx_coherent = (Zxx_h1 + Zxx_l1) / 2.0
    tf_metric = np.mean(np.abs(Zxx_coherent)**2, axis=0)
    
    # Map STFT time stamps to GPS times:
    # Assume that "times" is the full segment time base.
    segment_start = times[0]
    metric_times = segment_start + t_stft

    # Signal Identification and Veto Stage: Detect peaks in the combined metric.
    # Use adaptive thresholds based on the background median and required prominence.
    background_level = np.median(tf_metric)
    # Peaks must exceed 1.2 times the median and have sufficient prominence.
    peaks, properties = signal.find_peaks(tf_metric, height=background_level * 1.2,
                                          prominence=background_level * 0.5, distance=4)
    
    # Extract trigger information: The GPS time of the trigger, the ranking statistic,
    # and an estimated time uncertainty window.
    peak_times = metric_times[peaks]
    peak_heights = tf_metric[peaks]
    # Here a constant uncertainty (in seconds) is assumed, though it could be made adaptive.
    peak_deltat = np.full(len(peak_times), 5.0)
    
    return peak_times, peak_heights, peak_deltat

